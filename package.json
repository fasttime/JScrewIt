{
  "name": "jscrewit",
  "version": "3.4.0",
  "description": "Converts plain JavaScript into JSFuck code, which consists of only six different characters: ! ( ) + [ ]",
  "keywords": [
    "esoteric",
    "jsfuck",
    "obfuscation"
  ],
  "homepage": "https://jscrew.it",
  "bugs": "https://github.com/fasttime/JScrewIt/issues",
  "license": "ISC",
  "author": "Francesco Trotta <ft@fasttime.org> (https://github.com/fasttime)",
  "files": [
    "Features.md",
    "JScrewIt.html",
    "api-doc",
    "lib",
    "screw.js",
    "tools",
    "ui",
    "!.*"
  ],
  "main": "lib/jscrewit.js",
  "type": "commonjs",
  "bin": {
    "jscrewit": "screw.js"
  },
  "directories": {
    "lib": "lib",
    "doc": "doc",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fasttime/JScrewIt.git"
  },
  "scripts": {
    "build": "npm install && npm run -ws build && gulp",
    "docs": "gulp docs",
    "feature-info": "node dev/feature-info.mjs",
    "release": "npm version -m 'release %s' --tag-version-prefix=",
    "test": "mocha --check-leaks --ui=ebdd test/{*,*/*,*/*/*}.spec.js"
  },
  "devDependencies": {
    "@cucumber/gherkin": "^42.0.1",
    "@inquirer/rawlist": "^5.3.5",
    "@origin-1/eslint-config": "^1.19.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "acorn": "^8.18.0",
    "art-js": "^1.1.1",
    "basic-ftp": "^6.2.1",
    "c8js": "^0.9.1",
    "chalk": "^6.0.0",
    "del": "^8.0.1",
    "ebdd": "^0.8.4",
    "eslint-formatter-compact": "^9.0.1",
    "eslint-plugin-ebdd": "^0.2.0",
    "eslint-plugin-eslint-env": "^0.6.0",
    "expectations": "^1.0.0",
    "glob": "^13.0.6",
    "globals": "^17.12.0",
    "gulp": "^5.0.1",
    "gulp-eslint-new": "^2.6.2",
    "gulp-jsdoc3": "^3.0.0",
    "gulp-rename": "^2.1.0",
    "gulp-tap": "^2.0.0",
    "gulp-uglify": "^3.0.2",
    "handlebars": "^4.7.9",
    "mocha": "4",
    "mocha-bar": "^0.2.1",
    "postrequire": "^2.0.0",
    "rollup": "^4.63.1",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "sync-readable": "^0.0.2",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^7.0.2",
    "uglify-js": "3.19.1"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "./packages/*"
  ],
  "imports": {
    "#jscrewit": "./lib/jscrewit.js",
    "#tools/*": "./tools/*.js"
  },
  "types": "lib/jscrewit.d.ts"
}
